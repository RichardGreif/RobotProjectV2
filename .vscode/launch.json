            "program": "${workspaceFolder}/Viewer/build-qt-test/MapViewer.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/Viewer",
            "environment": [
                {
                    "name": "Path",
                    "value": "C:\\Qt\\Tools\\mingw1310_64\\bin;C:\\Qt\\6.11.0\\mingw_64\\bin;${env:Path}"
